{
  "name": "bangwit-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "biome lint src",
    "icons": "node scripts/generate-icons.mjs",
    "test:storage": "node --experimental-strip-types --test tests/catches-storage.test.mjs",
    "test:i18n": "node --experimental-strip-types --test tests/browser-language.test.mjs",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "typecheck": "tsc --noEmit",
    "test:evidence": "node --test tests/historical-evidence.test.mjs",
    "test:research": "node --experimental-strip-types --test tests/historical-evidence.test.mjs tests/cavite-fish-candidate-review.test.mjs tests/species-research.test.mjs",
    "species:status": "node scripts/species/research-status.mjs",
    "species:fetch:freshwater": "python scripts/species/import-freshwater-checklist.py --fetch",
    "species:build:freshwater": "python scripts/species/import-freshwater-checklist.py",
    "species:check:freshwater": "python scripts/species/import-freshwater-checklist.py --check",
    "species:check:administration": "node scripts/species/build-administrative-registry.mjs --check",
    "species:fetch:taxonomy": "node scripts/species/match-freshwater-taxonomy.mjs --fetch",
    "species:build:taxonomy": "node scripts/species/match-freshwater-taxonomy.mjs",
    "species:check:taxonomy": "node scripts/species/match-freshwater-taxonomy.mjs --check",
  "test:species:pipeline": "node --test tests/administrative-registry.test.mjs tests/national-species-research.test.mjs tests/freshwater-taxonomy.test.mjs tests/taal-checklist-evidence.test.mjs tests/makiling-gbif-evidence.test.mjs tests/laguna-de-bay-specimen-evidence.test.mjs tests/pansipit-river-gbif-evidence.test.mjs tests/caliraya-lumot-gbif-source-review.test.mjs tests/calabarzon-gbif-locality-sweep.test.mjs tests/field-source-reviews.test.mjs && python -m unittest discover -s tests -p freshwater_checklist_test.py",
    "test:offline": "node --experimental-strip-types --test tests/offline-precache.test.mjs",
    "test:advisories": "node --experimental-strip-types --test tests/map-advisories.test.mjs",
    "check:staging": "node scripts/check-staging.mjs",
    "species:build:taal": "node scripts/species/build-taal-checklist-evidence.mjs",
    "species:check:taal": "node scripts/species/build-taal-checklist-evidence.mjs --check",
    "species:build:river": "node scripts/species/build-palico-river-evidence.mjs",
    "species:check:river": "node scripts/species/build-palico-river-evidence.mjs --check",
    "species:build:makiling": "node scripts/species/build-makiling-gbif-evidence.mjs",
    "species:check:makiling": "node scripts/species/build-makiling-gbif-evidence.mjs --check",
    "species:build:laguna": "node scripts/species/build-laguna-de-bay-specimen-evidence.mjs",
    "species:check:laguna": "node scripts/species/build-laguna-de-bay-specimen-evidence.mjs --check",
    "species:build:pansipit": "node scripts/species/build-pansipit-river-gbif-evidence.mjs",
    "species:check:pansipit": "node scripts/species/build-pansipit-river-gbif-evidence.mjs --check",
    "species:check:field": "node scripts/species/check-field-source-reviews.mjs",
    "species:check:field:raw": "node scripts/species/check-field-source-reviews.mjs --raw",
    "species:fetch:field": "node scripts/species/check-field-source-reviews.mjs --fetch"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@serwist/turbopack": "9.5.12",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild-wasm": "0.28.1",
    "fake-indexeddb": "^6.2.5",
    "postcss": "8.5.28",
    "serwist": "9.5.12",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
